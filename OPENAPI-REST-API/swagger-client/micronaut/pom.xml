        <version>12.0.2</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-codec</artifactId>
        <version>4.1.136.Final</version>
      </dependency>
      <dependency>
        <groupId>io.micronaut</groupId>
