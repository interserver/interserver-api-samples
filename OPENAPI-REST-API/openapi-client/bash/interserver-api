  \"platform\": \"kvm\", \"os\": \"centos-7-x86_64\",
  \"slices\": 2, \"location\": 1, \"period\": 1,
  \"hostname\": \"web1.example.com\"
}
---" | paste -sd' ' - | fold -sw 80
