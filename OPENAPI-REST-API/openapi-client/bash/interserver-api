  \"serviceid\": 12345,
  \"iid\": \"25296600\",
  \"real_iids\": [\"25296600\"],
  \"iids\": [\"SERVICEvps12345\"],
  \"total_cost\": \"12.00\",
  \"invoice_description\": \"KVM 2 Slices\",
  \"cj_params\": {}
}
---
