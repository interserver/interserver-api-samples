        List<OAS.Param> form = new List<OAS.Param>();

        return (IntServerSuccessTextResponse) client.invoke(
            'POST', '/billing/payment_method',
            (IntServerBillingPaymentMethodRequest) params.get('intServerBillingPaymentMethodRequest'),
            query, form,
            new Map<String, Object>(),
            new Map<String, Object>(),
            new List<String>{ 'application/json' },
            new List<String>{ 'application/json', 'multipart/form-data' },
            new List<String> { 'sessionIdCookieAuth', 'apiKeyAuth', 'sessionIdHeaderAuth' },
