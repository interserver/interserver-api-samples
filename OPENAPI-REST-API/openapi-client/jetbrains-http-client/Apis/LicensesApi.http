## LicensesApi

### Order a new software license and create the recurring invoice
## Order a new software license and create the recurring invoice
POST https://my.interserver.net/apiv2/licenses/order
Content-Type: application/json
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "package": "<number>",
 "ip": "<string>",
 "tos": "<string>",
 "frequency": "<number>",
 "coupon": "<string>",
 "comment": "<string>"
}


### Get full details for one license including status, IP, and links
## Get full details for one license including status, IP, and links
GET https://my.interserver.net/apiv2/licenses/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### List all billing invoices tied to one software license service
## List all billing invoices tied to one software license service
GET https://my.interserver.net/apiv2/licenses/{{id}}/invoices
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### List all software licenses owned by the authenticated customer
