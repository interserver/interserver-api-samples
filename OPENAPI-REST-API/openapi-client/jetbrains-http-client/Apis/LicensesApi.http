### Cancel a license service and stop future billing (irreversible)
## Cancel a license service and stop future billing (irreversible)
DELETE https://my.interserver.net/apiv2/licenses/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Rebind a license to a new IP address (may incur a vendor fee)
## Rebind a license to a new IP address (may incur a vendor fee)
POST https://my.interserver.net/apiv2/licenses/{{id}}/change_ip
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "ip": "<string>"
}


