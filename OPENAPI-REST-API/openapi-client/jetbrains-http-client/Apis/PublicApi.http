### Begin OAuth login flow — redirect user to provider for authentication
## Begin OAuth login flow — redirect user to provider for authentication
GET https://my.interserver.net/apiv2/oauth?provider={{provider}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### List all PHP timezone identifiers usable on accounts and services
## List all PHP timezone identifiers usable on accounts and services
GET https://my.interserver.net/apiv2/account/timezones
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Submit 2FA code to finish OAuth login when account has 2FA enabled
## Submit 2FA code to finish OAuth login when account has 2FA enabled
PATCH https://my.interserver.net/apiv2/oauth
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "account_id": "<number>",
 "code": "<string>"
}


### Liveness check — returns the JSON string \&quot;pong\&quot; to confirm API is up
## Liveness check — returns the JSON string \&quot;pong\&quot; to confirm API is up
GET https://my.interserver.net/apiv2/ping
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Complete OAuth login by linking provider to existing or new account
## Complete OAuth login by linking provider to existing or new account
POST https://my.interserver.net/apiv2/oauth?provider={{provider}}
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "provider": "<string>"
}


### Authenticate with email + password and return a session token
## Authenticate with email + password and return a session token
POST https://my.interserver.net/apiv2/login
Content-Type: multipart/form-data
Content-Type: application/json
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Create a new customer account (email + password + captcha + ToS)
## Create a new customer account (email + password + captcha + ToS)
POST https://my.interserver.net/apiv2/signup
Content-Type: application/json
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
  "login" : "user@domain.com",
  "passwd" : "mypassword",
  "remember" : "{{true}}",
  "g-recaptcha-response" : {
    "__v_isShallow" : false,
    "dep" : {
      "w" : 0,
      "n" : 0
    },
    "__v_isRef" : {{true}},
    "_rawValue" : "zzzzz",
    "_value" : "zzzzz"
  }
}

