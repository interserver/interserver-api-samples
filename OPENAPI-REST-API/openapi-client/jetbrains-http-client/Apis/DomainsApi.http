## DomainsApi

### Place a new domain registration or transfer order, generate billing invoice
## Place a new domain registration or transfer order, generate billing invoice
POST https://my.interserver.net/apiv2/domains/order
Content-Type: application/json
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "hostname": "<string>",
 "type": "<string>",
 "coupon": "<string>",
 "whois_privacy": "<string>"
}


### Register DNSSEC DS records on the domain at OpenSRS
## Register DNSSEC DS records on the domain at OpenSRS
POST https://my.interserver.net/apiv2/domains/{{id}}/dnssec
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "algorithm": "<string>",
 "digest_type": "<string>",
 "digest": "<string>",
 "key_tag": "<string>"
}


### Register a new nameserver host with glue IP at the registry (registered nameserver)
## Register a new nameserver host with glue IP at the registry (registered nameserver)
POST https://my.interserver.net/apiv2/domains/{{id}}/nameservers
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "name": "<string>",
 "ipAddress": "<string>"
}


### Cancel a domain order in the billing system to stop auto-renewals
## Cancel a domain order in the billing system to stop auto-renewals
DELETE https://my.interserver.net/apiv2/domains/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Clear all DNSSEC DS records on the domain (disable DNSSEC at the registrar)
## Clear all DNSSEC DS records on the domain (disable DNSSEC at the registrar)
DELETE https://my.interserver.net/apiv2/domains/{{id}}/dnssec
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Remove one registered nameserver glue record from the domain
## Remove one registered nameserver glue record from the domain
DELETE https://my.interserver.net/apiv2/domains/{{id}}/nameservers?index={{index}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

