### Send email via Mail Baby SMTP relay with attachments, CC/BCC, and multi-recipient
## Send email via Mail Baby SMTP relay with attachments, CC/BCC, and multi-recipient
POST https://my.interserver.net/apiv2/mail/{{id}}/advsend
Content-Type: application/json
Content-Type: application/x-www-form-urlencoded
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
  "subject" : "Welcome",
  "body" : "Hello",
  "from" : {
    "email" : "user@domain.com"
  },
  "to" : [ {
    "email" : "someone@client.com",
    "name" : "Mr Client"
  } ],
  "attachments" : [ {
    "filename" : "message.txt",
    "data" : "base64_encoded_contents"
  } ],
  "id" : 66
}


