X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
  "user" : "mb20682",
  "type" : "email",
  "data" : "domeinwo@server.guesshost.net"
}


### Create a new Mail Baby alert for delivery, bounce, or quota events
## Create a new Mail Baby alert for delivery, bounce, or quota events
POST https://my.interserver.net/apiv2/mail/{{id}}/alerts
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "type": "<string>",
 "value": "<string>",
 "to": "<string>",
 "enabled": "<string>"
}


