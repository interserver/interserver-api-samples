### Update a ticket&#39;s properties such as subject or status (stub, not implemented)
## Update a ticket&#39;s properties such as subject or status (stub, not implemented)
PUT https://my.interserver.net/apiv2/tickets/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Post a simple text reply to an existing ticket thread (no attachments)
## Post a simple text reply to an existing ticket thread (no attachments)
POST https://my.interserver.net/apiv2/tickets/{{id}}/reply
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "content": "<string>"
}


### Update a ticket&#39;s custom field values (server-access details, etc.)
## Update a ticket&#39;s custom field values (server-access details, etc.)
POST https://my.interserver.net/apiv2/tickets/{{id}}/update
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "ip": "<string>",
 "ip_address": "<string>",
 "customer_server_access": "<string>",
 "root_password": "<string>",
 "sudo_username": "<string>",
 "sudo_password": "<string>",
 "port": "<number>"
}

