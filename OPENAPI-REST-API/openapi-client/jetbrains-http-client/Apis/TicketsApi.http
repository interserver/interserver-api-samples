## TicketsApi

### Open a new helpdesk ticket, optionally linked to a service and attachments
## Open a new helpdesk ticket, optionally linked to a service and attachments
POST https://my.interserver.net/apiv2/tickets/new
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "subject": "<string>",
 "body": "<string>",
 "service_id": "<number>",
 "service_module": "<string>"
}


### Close an open support ticket via simple GET request (no body required)
## Close an open support ticket via simple GET request (no body required)
GET https://my.interserver.net/apiv2/tickets/{{id}}/close
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Close a customer ticket via DELETE verb (closes only, never destroys data)
## Close a customer ticket via DELETE verb (closes only, never destroys data)
DELETE https://my.interserver.net/apiv2/tickets/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Fetch services and product options to populate the new-ticket form
## Fetch services and product options to populate the new-ticket form
GET https://my.interserver.net/apiv2/tickets/new
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Get full ticket details including subject, status, and the reply thread
## Get full ticket details including subject, status, and the reply thread
GET https://my.interserver.net/apiv2/tickets/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### List the authenticated account&#39;s support tickets with status and date filters
## List the authenticated account&#39;s support tickets with status and date filters
GET https://my.interserver.net/apiv2/tickets?page={{page}}&period={{period}}&view={{view}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

