Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "ips": "<string>"
}


### Read IPMI chassis power status for many dedicated servers in one call
## Read IPMI chassis power status for many dedicated servers in one call
GET https://my.interserver.net/apiv2/servers/bulk/ipmi_power?ids={{ids}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

