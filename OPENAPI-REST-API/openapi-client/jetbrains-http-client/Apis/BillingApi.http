Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

### Place two micro-charges on the card to start CVV verification (step 1 of 2)
## Place two micro-charges on the card to start CVV verification (step 1 of 2)
PATCH https://my.interserver.net/apiv2/billing/creditcards/{{id}}/verify
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "cc_ccv2": "<string>"
}


### Submit two micro-charge amounts to finalize card verification (step 2 of 2)
## Submit two micro-charge amounts to finalize card verification (step 2 of 2)
POST https://my.interserver.net/apiv2/billing/creditcards/{{id}}/verify
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "idx": "<number>",
 "cc_ccv2": "<string>",
 "cc_amount1": "<string>",
 "cc_amount2": "<string>",
 "terms": "<string>"
}


