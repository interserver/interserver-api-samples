## BillingApi

### Store a credit card on the account — may return a verification flow
## Store a credit card on the account — may return a verification flow
POST https://my.interserver.net/apiv2/billing/creditcards
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "name": "<string>",
 "address": "<string>",
 "city": "<string>",
 "state": "<string>",
 "country": "<string>",
 "zip": "<string>",
 "cc": "<string>",
 "cc_exp": "<string>",
 "cc_ccv2": "<string>"
}


### Create a prepay deposit and return an invoice id to fund it
## Create a prepay deposit and return an invoice id to fund it
POST https://my.interserver.net/apiv2/billing/prepays
Content-Type: application/json
Content-Type: multipart/form-data
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

{
 "module": "<string>",
 "amount": "<number>",
 "automatic_use": "<string>"
}


### Remove a stored credit card from the account
## Remove a stored credit card from the account
DELETE https://my.interserver.net/apiv2/billing/creditcards/{{id}}
Accept: application/json
true
Cookie: sessionid={{cookieKey}}
X-API-KEY: {{apiKey}}
sessionid: {{apiKey}}

